{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "tgu_badges": {
          "type": "tgu_badges",
          "settings": {
            "show_condition": true,
            "show_deal": true
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 5,
            "show_inventory_quantity": true
          }
        },
        "tgu_compare": {
          "type": "tgu_compare",
          "settings": {
            "retail_label": "Retail price",
            "our_label": "Our price",
            "save_label": "You save"
          }
        },
        "tgu_condition": {
          "type": "tgu_condition",
          "settings": {}
        },
        "tgu_visit_prompt": {
          "type": "tgu_visit_prompt",
          "settings": {
            "heading": "Want to see it first?",
            "text": "Come take a look at our Franklin showroom.",
            "link_label": "Book a visit",
            "link": ""
          }
        },
        "faq_see": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Can I see it before I buy?",
            "icon": "eye",
            "content": "<p>Yes. Book a visit to our showroom at 9924 S Monarch Dr in Franklin, WI, and we'll show you around.</p>"
          }
        },
        "faq_price": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Why is it priced so low?",
            "icon": "price_tag",
            "content": "<p>We buy overstock, shelf pulls and returns, and pass the savings on to you. That's also why stock changes and most items are one of a kind.</p>"
          }
        },
        "faq_returns": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Returns",
            "icon": "return",
            "content": "<p>See our <a href=\"/policies/refund-policy\">return policy</a> for the details.</p>"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "tgu_compare",
        "inventory",
        "tgu_condition",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "tgu_visit_prompt",
        "description",
        "faq_see",
        "faq_price",
        "faq_returns",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "More finds",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "recently_viewed": {
      "type": "tgu-recently-viewed",
      "settings": {
        "heading": "Your recent finds",
        "limit": 6,
        "color_scheme": "scheme-1",
        "padding_top": 24,
        "padding_bottom": 64
      }
    },
    "breadcrumbs": {
      "type": "tgu-breadcrumbs",
      "settings": {
        "color_scheme": "scheme-1"
      }
    }
  },
  "order": [
    "breadcrumbs",
    "main",
    "disclosures",
    "related-products",
    "recently_viewed"
  ]
}