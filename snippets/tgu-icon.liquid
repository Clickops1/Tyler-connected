{%- comment -%}
  TGU monoline icons, drawn on a 100×100 grid: stroke currentColor, 4.2 stroke, round caps and joins (guidelines §6).
  Never fill them or add colors.

  Accepts:
  - icon: {String} tools | sofa | electronics | watch | home | box | pin | calendar | phone | trail | mountains
  - class: {String} extra classes (optional)

  Usage:
  {% render 'tgu-icon', icon: 'tools' %}
{%- endcomment -%}
<svg
  class="tgu-icon {{ class }}"
  viewBox="0 0 100 100"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  {%- case icon -%}
    {%- when 'tools' -%}
      <path d="M22 78 L54 46"/>
      <path d="M54 46 C50 36 54 24 66 20 C70 19 74 19 77 21 L66 32 L70 38 L76 40 L86 30 C88 34 88 39 86 43 C82 53 72 56 62 52 Z"/>
      <path d="M18 82 L26 74"/>
      <path d="M30 26 L48 44"/>
      <path d="M22 18 L34 30 L30 34 L18 22 Z"/>
      <path d="M58 60 L78 80 C80 82 83 82 85 80 C87 78 87 75 85 73 L65 53"/>
    {%- when 'sofa' -%}
      <path d="M22 50 V38 C22 32 26 28 32 28 H68 C74 28 78 32 78 38 V50"/>
      <path d="M14 56 C14 50 22 48 26 52 V60 H74 V52 C78 48 86 50 86 56 V72 H14 Z"/>
      <path d="M22 72 V80"/>
      <path d="M78 72 V80"/>
      <path d="M50 30 V60"/>
    {%- when 'electronics' -%}
      <rect x="14" y="22" width="72" height="46" rx="5"/>
      <path d="M38 80 H62"/>
      <path d="M50 68 V80"/>
      <path d="M24 32 L34 32"/>
    {%- when 'watch' -%}
      <circle cx="50" cy="50" r="20"/>
      <path d="M50 38 V50 L58 56"/>
      <path d="M38 34 L40 16 H60 L62 34"/>
      <path d="M38 66 L40 84 H60 L62 66"/>
    {%- when 'home' -%}
      <path d="M16 48 L50 20 L84 48"/>
      <path d="M26 40 V82 H74 V40"/>
      <path d="M42 82 V60 H58 V82"/>
    {%- when 'box' -%}
      <path d="M18 36 L50 22 L82 36 V70 L50 84 L18 70 Z"/>
      <path d="M18 36 L50 50 L82 36"/>
      <path d="M50 50 V84"/>
      <path d="M34 29 L66 43"/>
    {%- when 'pin' -%}
      <path d="M50 86 C50 86 24 58 24 40 C24 25 36 14 50 14 C64 14 76 25 76 40 C76 58 50 86 50 86 Z"/>
      <circle cx="50" cy="40" r="10"/>
    {%- when 'calendar' -%}
      <rect x="16" y="24" width="68" height="60" rx="6"/>
      <path d="M16 40 H84"/>
      <path d="M34 16 V30"/>
      <path d="M66 16 V30"/>
      <path d="M32 56 H40"/>
      <path d="M48 56 H56"/>
      <path d="M32 70 H40"/>
    {%- when 'phone' -%}
      <path d="M30 16 L40 16 L46 32 L38 38 C42 48 52 58 62 62 L68 54 L84 60 V70 C84 78 78 84 70 84 C42 82 18 58 16 30 C16 22 22 16 30 16 Z"/>
    {%- when 'trail' -%}
      <path d="M14 80 C30 80 30 62 46 62 S62 44 78 44" stroke-dasharray="2 9"/>
      <circle cx="82" cy="40" r="6"/>
      <circle cx="14" cy="80" r="3"/>
    {%- else -%}
      <path d="M12 74 L42 38 L58 56"/>
      <path d="M48 46 L64 28 L88 56"/>
      <path d="M34 74 L50 56 L66 74"/>
      <path d="M10 82 C26 78 34 84 50 80 S78 76 90 80"/>
  {%- endcase -%}
</svg>
