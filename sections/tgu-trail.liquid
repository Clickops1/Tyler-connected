{{ 'tgu-sections.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .tgu-section {
    --tgu-pt: {{ section.settings.padding_top | times: 0.67 | round }}px;
    --tgu-pb: {{ section.settings.padding_bottom | times: 0.67 | round }}px;
    --tgu-pt-d: {{ section.settings.padding_top }}px;
    --tgu-pb-d: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="tgu-trail tgu-section{% if section.settings.contours %} tgu-contours{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="tgu-inner">
    <div class="tgu-trail__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="tgu-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="tgu-h2 tgu-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="tgu-body-l">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <ol class="tgu-trail__steps" style="--tgu-steps: {{ section.blocks.size | at_least: 1 | at_most: 5 }};" role="list">
      {%- for block in section.blocks -%}
        <li
          class="tgu-trail__step{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="tgu-trail__marker">
            {% render 'tgu-icon', icon: block.settings.icon %}
            <span class="tgu-trail__num" aria-hidden="true">{{ forloop.index }}</span>
          </div>
          <div>
            <h3 class="tgu-trail__title">
              <span class="visually-hidden">Step {{ forloop.index }}: </span>
              {{- block.settings.title | escape -}}
            </h3>
            {%- if block.settings.text != blank -%}
              <p class="tgu-trail__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="tgu-buttons" style="justify-content: center; margin-top: 6.4rem;">
        <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "TGU trail (how it works)",
  "tag": "div",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow the trail."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "contours",
      "label": "Show contour lines",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "mountains",
          "options": [
            { "value": "mountains", "label": "Mountains" },
            { "value": "check", "label": "Check mark" },
            { "value": "trail", "label": "Trail" },
            { "value": "pin", "label": "Map pin" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "box", "label": "Box" },
            { "value": "home", "label": "Home" },
            { "value": "tools", "label": "Tools" },
            { "value": "phone", "label": "Phone" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TGU trail (how it works)",
      "blocks": [
        { "type": "step", "settings": { "icon": "trail", "title": "Spot the find" } },
        { "type": "step", "settings": { "icon": "pin", "title": "Come see it" } },
        { "type": "step", "settings": { "icon": "home", "title": "Make it yours" } }
      ]
    }
  ]
}
{% endschema %}
