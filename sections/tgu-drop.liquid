{{ 'tgu-sections.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Next drop: a real countdown to Tyler's next restock. With no date set, it shows no countdown at all (the brand never
  fakes urgency). After the date passes it flips to "Live now" and links to the drop's collection.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} .tgu-section {
    --tgu-pt: {{ section.settings.padding_top | times: 0.67 | round }}px;
    --tgu-pb: {{ section.settings.padding_bottom | times: 0.67 | round }}px;
    --tgu-pt-d: {{ section.settings.padding_top }}px;
    --tgu-pb-d: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- assign drop_collection = section.settings.collection -%}

<section class="tgu-drop tgu-section tgu-contours color-{{ section.settings.color_scheme }} gradient">
  <div class="tgu-inner">
    <tgu-drop-countdown
      class="tgu-drop__grid{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      data-date="{{ section.settings.drop_date | escape }}"
    >
      <div class="tgu-drop__copy">
        <span class="badge tgu-badge--deal tgu-drop__badge" data-state-upcoming>{{ section.settings.badge | escape }}</span>
        <span class="badge tgu-badge--deal tgu-drop__badge tgu-drop__badge--live" data-state-live hidden>{{ section.settings.live_badge | escape }}</span>
        <h2 class="tgu-h2 tgu-heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="tgu-drop__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if drop_collection != blank and drop_collection.products_count > 0 -%}
          <p class="tgu-drop__count">
            <strong>{{ drop_collection.products_count }}</strong>
            {{ section.settings.count_label | escape }}
          </p>
        {%- endif -%}
        <div class="tgu-buttons" data-state-live hidden>
          <a class="button" href="{{ drop_collection.url | default: routes.all_products_collection_url }}">
            {{- section.settings.live_button | escape -}}
          </a>
        </div>
      </div>

      <div class="tgu-drop__side">
        <div class="tgu-drop__clock" data-state-upcoming {% if section.settings.drop_date == blank %}hidden{% endif %} role="timer" aria-live="off">
          {%- assign units = 'days,hours,minutes,seconds' | split: ',' -%}
          {%- for unit in units -%}
            <div class="tgu-drop__unit">
              <span class="tgu-drop__num" data-unit="{{ unit }}">--</span>
              <span class="tgu-drop__label">{{ unit }}</span>
            </div>
          {%- endfor -%}
        </div>

        {%- form 'customer', class: 'tgu-drop__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,drop-alerts">
          {%- if form.posted_successfully? -%}
            <p class="form__message">{{ section.settings.success | escape }}</p>
          {%- else -%}
            <label class="tgu-drop__form-label" for="TguDropEmail-{{ section.id }}">{{ section.settings.form_label | escape }}</label>
            <div class="tgu-teaser__form">
              <div class="field">
                <input
                  id="TguDropEmail-{{ section.id }}"
                  class="field__input"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  placeholder="{{ 'newsletter.label' | t }}"
                  required
                >
                <label class="field__label" for="TguDropEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
              </div>
              <button class="button" type="submit">{{ section.settings.form_button | escape }}</button>
            </div>
            {%- if form.errors -%}
              <p class="form__message">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </tgu-drop-countdown>
  </div>
</section>

{% schema %}
{
  "name": "TGU next drop",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Only set a date for a real restock. Leave it blank and no countdown shows."
    },
    {
      "type": "text",
      "id": "drop_date",
      "label": "Drop date and time",
      "info": "Format: 2026-11-20T10:00-06:00 (the -06:00 is Central time; use -05:00 in summer)."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Drop collection",
      "info": "Shows how many items are in the drop and where the Live button goes."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge before the drop",
      "default": "Next drop"
    },
    {
      "type": "text",
      "id": "live_badge",
      "label": "Badge once it's live",
      "default": "Live now"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The next truckload."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Fresh overstock and returns, straight to the shelves. Get a heads-up the moment it lands."
    },
    {
      "type": "text",
      "id": "count_label",
      "label": "Item count label",
      "default": "new finds in this drop"
    },
    {
      "type": "text",
      "id": "live_button",
      "label": "Live button",
      "default": "See the drop"
    },
    {
      "type": "text",
      "id": "form_label",
      "label": "Sign-up label",
      "default": "Get drop alerts"
    },
    {
      "type": "text",
      "id": "form_button",
      "label": "Sign-up button",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "success",
      "label": "Success message",
      "default": "You're in. We'll email you when the next drop lands."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "TGU next drop"
    }
  ]
}
{% endschema %}
