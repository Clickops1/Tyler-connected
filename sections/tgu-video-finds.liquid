{{ 'tgu-sections.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Shoppable finds videos: vertical clips (upload in Shopify Files) that each link to the product shown.
  Videos play muted while on screen and pause off screen. No video uploaded yet: a branded placeholder shows.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} .tgu-section {
    --tgu-pt: {{ section.settings.padding_top | times: 0.67 | round }}px;
    --tgu-pb: {{ section.settings.padding_bottom | times: 0.67 | round }}px;
    --tgu-pt-d: {{ section.settings.padding_top }}px;
    --tgu-pb-d: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="tgu-reels tgu-section color-{{ section.settings.color_scheme }} gradient">
  <div class="tgu-inner">
    <div class="tgu-row-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="tgu-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="tgu-h2 tgu-heading">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.follow_label != blank and settings.social_tiktok_link != blank -%}
        <a class="button button--secondary" href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">
          {{- section.settings.follow_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    <ul class="tgu-reels__track" role="list">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <li
          class="tgu-reel{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="tgu-reel__media">
            {%- if block.settings.video != blank -%}
              {{
                block.settings.video
                | video_tag: autoplay: false, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'tgu-reel__video', image_size: '600x'
              }}
            {%- else -%}
              <div class="tgu-reel__placeholder" aria-hidden="true">
                {% render 'tgu-icon', icon: 'mountains' %}
                <span>Video coming soon</span>
              </div>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <p class="tgu-reel__caption">{{ block.settings.caption | escape }}</p>
            {%- endif -%}
          </div>
          {%- if p != blank -%}
            <a class="tgu-reel__product" href="{{ p.url }}">
              {%- if p.featured_media -%}
                {{ p.featured_media | image_url: width: 120 | image_tag: width: 48, height: 48, loading: 'lazy', class: 'tgu-reel__thumb', alt: '' }}
              {%- endif -%}
              <span class="tgu-reel__product-text">
                <span class="tgu-reel__product-title">{{ p.title | escape }}</span>
                <span class="tgu-reel__product-price">
                  {%- if p.available -%}{{ p.price | money }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                </span>
              </span>
              <span class="tgu-reel__arrow" aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "TGU finds videos",
  "tag": "div",
  "class": "section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Straight from the aisles"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch the hunt."
    },
    {
      "type": "text",
      "id": "follow_label",
      "label": "TikTok button",
      "default": "Follow on TikTok"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Vertical video",
          "info": "Short, muted-friendly clip (5–20 seconds). Upload it here or in Content > Files."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Look what came off the truck"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product shown"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TGU finds videos",
      "blocks": [
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" }
      ]
    }
  ]
}
{% endschema %}
