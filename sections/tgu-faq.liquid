{{ 'tgu-sections.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Searchable FAQ grouped by category. Add a "Category" block, then the "Question" blocks that belong under it.
  Outputs FAQPage structured data for search engines from the same questions.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} .tgu-section {
    --tgu-pt: {{ section.settings.padding_top | times: 0.67 | round }}px;
    --tgu-pb: {{ section.settings.padding_bottom | times: 0.67 | round }}px;
    --tgu-pt-d: {{ section.settings.padding_top }}px;
    --tgu-pb-d: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- liquid
  assign category_count = 0
  for block in section.blocks
    if block.type == 'category'
      assign category_count = category_count | plus: 1
    endif
  endfor
-%}

<section class="tgu-faq tgu-section color-{{ section.settings.color_scheme }} gradient">
  <div class="tgu-inner">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="tgu-faq__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="tgu-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="tgu-h2 tgu-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <tgu-faq class="tgu-faq__layout{% if category_count > 1 %} tgu-faq__layout--nav{% endif %}">
      {%- if category_count > 1 -%}
        <aside class="tgu-faq__nav">
          {%- if section.settings.show_search -%}
            <label class="tgu-faq__search">
              <span class="visually-hidden">{{ section.settings.search_label | escape }}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
              <input type="search" placeholder="{{ section.settings.search_label | escape }}" data-faq-search autocomplete="off">
            </label>
          {%- endif -%}
          <nav aria-label="FAQ topics">
            <ul role="list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'category' -%}
                  <li><a href="#faq-{{ block.settings.title | handleize }}" data-faq-link>{{ block.settings.title | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </nav>
        </aside>
      {%- elsif section.settings.show_search -%}
        <label class="tgu-faq__search tgu-faq__search--solo">
          <span class="visually-hidden">{{ section.settings.search_label | escape }}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
          <input type="search" placeholder="{{ section.settings.search_label | escape }}" data-faq-search autocomplete="off">
        </label>
      {%- endif -%}

      <div class="tgu-faq__body">
        {%- comment -%} Questions placed before the first category {%- endcomment -%}
        {%- capture loose -%}
          {%- for q in section.blocks -%}
            {%- if q.type == 'category' -%}{%- break -%}{%- endif -%}
            {%- render 'tgu-faq-item', block: q -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if loose != blank -%}
          <div class="tgu-faq__group" data-faq-group>{{ loose }}</div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'category' -%}
            {%- assign start = forloop.index -%}
            <div class="tgu-faq__group" id="faq-{{ block.settings.title | handleize }}" data-faq-group {{ block.shopify_attributes }}>
              <h3 class="tgu-faq__group-title">{{ block.settings.title | escape }}</h3>
              {%- for q in section.blocks offset: start -%}
                {%- if q.type == 'category' -%}{%- break -%}{%- endif -%}
                {%- render 'tgu-faq-item', block: q -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
        <p class="tgu-faq__empty" data-faq-empty hidden>{{ section.settings.empty_text | escape }}</p>
      </div>
    </tgu-faq>

    {%- if section.settings.cta_heading != blank -%}
      <div class="tgu-faq__cta">
        <div>
          <p class="tgu-faq__cta-title">{{ section.settings.cta_heading | escape }}</p>
          {%- if section.settings.cta_text != blank -%}
            <p class="tgu-faq__cta-text">{{ section.settings.cta_text | escape }}</p>
          {%- endif -%}
        </div>
        <div class="tgu-buttons" style="margin-top: 0;">
          {%- if section.settings.cta_label != blank -%}
            <a class="button" href="{{ section.settings.cta_link | default: '/pages/visit' }}">{{ section.settings.cta_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.schema -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign first = true -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'question' and block.settings.question != blank and block.settings.answer != blank -%}
            {%- unless first -%},{%- endunless -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} }
            }
            {%- assign first = false -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "TGU FAQ",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Add a Category block, then its Question blocks under it. Only answer with confirmed details; link to your policies for shipping and returns."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "text", "id": "search_label", "label": "Search placeholder", "default": "Search questions" },
    { "type": "text", "id": "empty_text", "label": "No results text", "default": "No questions match that. Try another word, or send us a message." },
    { "type": "checkbox", "id": "schema", "label": "Add FAQ structured data for search engines", "default": true, "info": "Turn off if the same questions appear on another page." },
    { "type": "text", "id": "cta_heading", "label": "Help box heading", "default": "Still wondering?" },
    { "type": "text", "id": "cta_text", "label": "Help box text", "default": "Come see the store in person, or send us a message." },
    { "type": "text", "id": "cta_label", "label": "Help box button", "default": "Visit or contact us" },
    { "type": "url", "id": "cta_link", "label": "Help box link", "info": "Defaults to /pages/visit" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shopping" }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TGU FAQ",
      "blocks": [
        { "type": "category", "settings": { "title": "Shopping" } },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
