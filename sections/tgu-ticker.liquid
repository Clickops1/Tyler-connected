{{ 'tgu-sections.css' | asset_url | stylesheet_tag }}

{%- capture ticker_items -%}
  {%- for block in section.blocks -%}
    <li class="tgu-ticker__item" {{ block.shopify_attributes }}>
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}" class="link link--text" style="color: inherit; text-decoration: none;">{{ block.settings.text | escape }}</a>
      {%- else -%}
        <span>{{ block.settings.text | escape }}</span>
      {%- endif -%}
      <svg viewBox="0 0 48 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M2 22 L16 6 L24 14 L32 4 L46 22"/></svg>
    </li>
  {%- endfor -%}
{%- endcapture -%}

<div
  class="tgu-ticker color-{{ section.settings.color_scheme }} gradient"
  style="--tgu-ticker-speed: {{ section.settings.speed }}s;"
>
  <div class="tgu-ticker__track">
    <ul class="tgu-ticker__group" role="list" aria-label="{{ section.settings.label | escape }}">
      {{ ticker_items }}
    </ul>
    <ul class="tgu-ticker__group" role="list" aria-hidden="true">
      {{ ticker_items | replace: '<a ', '<a tabindex="-1" ' }}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "TGU finds ticker",
  "tag": "div",
  "class": "section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "paragraph",
      "content": "A slow scrolling strip of the kinds of things on the shelves. It pauses on hover and stays still for visitors who turn off motion."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Accessible label",
      "default": "Things you might find"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "s",
      "label": "Seconds per loop",
      "default": 45
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Find"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TGU finds ticker",
      "blocks": [
        { "type": "item", "settings": { "text": "Recliners" } },
        { "type": "item", "settings": { "text": "Pallets of tile" } },
        { "type": "item", "settings": { "text": "Smartwatches" } },
        { "type": "item", "settings": { "text": "Power tools" } },
        { "type": "item", "settings": { "text": "Home goods" } }
      ]
    }
  ]
}
{% endschema %}
