{{ 'tgu-sections.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Recently viewed products, kept in the shopper's own browser (localStorage). Prices and availability are fetched fresh
  each time, so a sold item shows as sold. Hidden until the shopper has viewed at least one other product.
{%- endcomment -%}

<tgu-recently-viewed
  class="tgu-recent color-{{ section.settings.color_scheme }} gradient"
  data-limit="{{ section.settings.limit }}"
  data-sold-label="{{ 'products.product.sold_out' | t | escape }}"
  {% if template.name == 'product' and product %}
    data-current-handle="{{ product.handle | escape }}"
  {% endif %}
  hidden
>
  <div class="tgu-inner" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    {%- if section.settings.heading != blank -%}
      <h2 class="tgu-recent__heading tgu-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="tgu-recent__grid" data-tgu-recent-grid role="list"></ul>
  </div>
</tgu-recently-viewed>

{% schema %}
{
  "name": "TGU recently viewed",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your recent finds"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 6
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "TGU recently viewed"
    }
  ]
}
{% endschema %}
