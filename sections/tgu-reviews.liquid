{{ 'tgu-sections.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Rotating customer reviews. Add one block per REAL review (copied from Google, Facebook or a reviews app, with the
  customer's permission). With no reviews added, the section stays hidden on the live store.
{%- endcomment -%}

{%- if section.blocks.size > 0 or request.design_mode -%}
  <section class="tgu-reviews tgu-section color-{{ section.settings.color_scheme }} gradient" style="--tgu-pt: {{ section.settings.padding_top | times: 0.67 | round }}px; --tgu-pb: {{ section.settings.padding_bottom | times: 0.67 | round }}px; --tgu-pt-d: {{ section.settings.padding_top }}px; --tgu-pb-d: {{ section.settings.padding_bottom }}px;">
    <div class="tgu-inner">
      <div class="tgu-reviews__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="tgu-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="tgu-h2 tgu-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <tgu-reviews class="tgu-reviews__stage" data-interval="{{ section.settings.interval }}" aria-roledescription="carousel" aria-label="{{ section.settings.heading | escape }}">
          <div class="tgu-reviews__track">
            {%- for block in section.blocks -%}
              <figure
                class="tgu-review{% if forloop.first %} is-active{% endif %}"
                aria-roledescription="slide"
                aria-label="{{ forloop.index }} of {{ forloop.length }}"
                {% unless forloop.first %}aria-hidden="true"{% endunless %}
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.rating > 0 -%}
                  <div class="tgu-review__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
                    {%- for i in (1..5) -%}
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="{% if i <= block.settings.rating %}is-on{% endif %}"><path d="M12 2.5l2.9 6.2 6.6.6-5 4.5 1.5 6.6L12 17l-6 3.4 1.5-6.6-5-4.5 6.6-.6z"/></svg>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                <blockquote class="tgu-review__quote">{{ block.settings.quote | escape }}</blockquote>
                <figcaption class="tgu-review__by">
                  <span class="tgu-review__name">{{ block.settings.name | escape }}</span>
                  {%- if block.settings.source != blank -%}
                    <span class="tgu-review__source">{{ block.settings.source | escape }}</span>
                  {%- endif -%}
                </figcaption>
              </figure>
            {%- endfor -%}
          </div>
          {%- if section.blocks.size > 1 -%}
            <div class="tgu-reviews__controls">
              <button type="button" class="tgu-reviews__btn" data-prev aria-label="Previous review">&larr;</button>
              <div class="tgu-reviews__dots" role="tablist">
                {%- for block in section.blocks -%}
                  <button type="button" class="tgu-reviews__dot{% if forloop.first %} is-active{% endif %}" data-dot="{{ forloop.index0 }}" aria-label="Show review {{ forloop.index }}"></button>
                {%- endfor -%}
              </div>
              <button type="button" class="tgu-reviews__btn" data-next aria-label="Next review">&rarr;</button>
            </div>
          {%- endif -%}
        </tgu-reviews>
      {%- else -%}
        <p class="tgu-empty">Add real customer reviews as blocks. This section stays hidden on the live store until you do.</p>
      {%- endif -%}

      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <div class="tgu-buttons" style="justify-content: center;">
          <a class="button button--secondary" href="{{ section.settings.link }}" target="_blank" rel="noopener">{{ section.settings.link_label | escape }}</a>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "TGU reviews",
  "tag": "div",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Only add real reviews, copied word for word with the customer's name as they gave it. Hidden on the live store until you add one."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From our customers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Finds people love." },
    { "type": "range", "id": "interval", "min": 4, "max": 15, "step": 1, "unit": "s", "label": "Seconds per review", "default": 7 },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Read more reviews" },
    { "type": "url", "id": "link", "label": "Button link", "info": "e.g. your Google reviews page." },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Review text" },
        { "type": "text", "id": "name", "label": "Customer name", "info": "As the customer gave it, e.g. \"Sarah M.\"" },
        { "type": "text", "id": "source", "label": "Source", "default": "Google review" },
        { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 1, "label": "Stars (0 hides them)", "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "TGU reviews"
    }
  ]
}
{% endschema %}
